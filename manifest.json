{
  "manifest_version": 3,
  "name": "LinkedIn Suggested Post Blocker",
  "version": "1.0",
  "description": "A browser extension that blocks suggested posts on LinkedIn",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Block LinkedIn Suggested Posts"
  },
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-suggested-blocker@example.com",
      "strict_min_version": "57.0"
    }
  }
}
